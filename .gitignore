# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log

# env files - tracked intentionally (private repo only!)
# .env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# user data - tracked for multi-device sync (private repo only!)
# /data/
# /public/screenshots/

# Bot/Bridge configs (contain MT5 credentials)
bots/*/config.json
bridge/config.json

# Python runtime artifacts
__pycache__/
*.pyc
*.pyo

# Bridge operational log (changes on every run)
bridge/bridge_log.json

# AI tool artifacts (local only, not needed on GitHub)
ruvector.db
agentdb.rvf
agentdb.rvf.lock
skills-lock.json
/.claude-flow/
/.swarm/
/.agents/

# Ghost files created by cmd.exe misinterpreting > in code prompts
# (bug in @claude-flow/cli hive-mind on Windows — safe to delete these)
nul
nul'
0)
fixed
inset-0
bottom-0
top-0
left-0
w-56
"!before.includes*"
