# AlphaTrack Umgebungsvariablen
# Kopiere diese Datei nach .env.local und trage deine Werte ein

# Anthropic API (fuer KI-Features)
ANTHROPIC_API_KEY=sk-ant-...

# Twelve Data API (fuer Kursdaten)
TWELVE_DATA_API_KEY=...

# Bot-Authentifizierung
# Muss mit bot/config.json "api_key" uebereinstimmen
BOT_API_KEY=REDACTED-API-KEY

# Bot Command-Server URL (IP des Trading-Rechners im LAN)
# Wird automatisch aus bots.json gelesen - hier nur als Fallback
BOT_URL=http://<TRADING-RECHNER-IP>:8765

# Nur falls die Bridge-Auto-Discovery nicht funktioniert (anderes Subnetz als 192.168.178.x)
LAN_SUBNET_PREFIX=192.168.178